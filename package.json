{
	"name": "obsidian-symlink-manager",
	"version": "1.0.3",
	"description": "Manage folder symlinks \u2014 link external folders into your vault, toggle them on/off, and manage connections from settings.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node scripts/candidate.mjs",
		"test": "node scripts/test.mjs",
		"lint": "eslint src/",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"release:check": "node scripts/release-check.mjs"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "16.5.0",
		"obsidian": "1.14.4",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.72.1"
	},
	"overrides": {
		"moment": "2.31.0"
	}
}
